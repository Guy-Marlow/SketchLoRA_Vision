#!/bin/bash
#SBATCH --job-name=wave1_final_completion
#SBATCH --time=160:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/wave1_final_completion/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/wave1_final_completion/slurm_%j.err
#
# Completes the wave1_final grid (2026-08-19 user request): CL-LoRA/EASE/TUNA
# at their settled learning rates, full task counts, 3 seeds -- no prior
# campaign ever ran these three at production scale, only truncated LR
# sweeps (see other_methods_config_and_lr_sweep memory). Plus a fresh O-LoRA
# rerun on the same grid for current-code persistent-memory numbers
# (persistent_state() was reworked in commit 23c6405, 2026-08-10, removing
# the dense-fold accounting; wave1_final's ORIGINAL O-LoRA runs, 2026-08-05,
# predate that fix -- same rationale as wave1_rerun_treelora, which covered
# TreeLoRA but explicitly scoped O-LoRA out at the time).
#
# 60 runs total: O-LoRA rerun (15: 5 datasets x 3 seeds) + CL-LoRA/EASE/TUNA
# (45: 3 methods x 5 datasets x 3 seeds). Configs: exps/wave1_final_completion/,
# generated by scripts/gen_wave1_final_completion_configs.py (idempotent,
# called fresh below).
#
# SETTLED LEARNING RATES (other_methods_config_and_lr_sweep memory,
# 2026-08-13 decision): CL-LoRA 0.05 uniformly; EASE 1e-2 uniformly; TUNA
# 5e-3 on ImageNet-R/OmniBenchmark-1K, 1e-3 elsewhere.
#
# FULL_METRICS=true/print_forget=true for all 60 configs -- this is a
# production run, not a sweep, so real MetricsLogger/CE-ledger output is
# wanted this time (unlike every truncated cllora_ease_tuna_* sweep before
# it, which deliberately ran with logging off).
#
# WALL TIME -- FLAGGED, GENUINE UNCERTAINTY FOR 3 OF THE 4 METHODS HERE.
# O-LoRA: confident estimate, real measured per-dataset times this project
# (bankcap_wave1_imagenetr20t_campaign memory) -- sun397 ~28min, imagenetr
# ~32min, cifar224 ~48.5min, food101 ~81min, omnibenchmark1k ~3h22min;
# ~6.5h/seed x 3 seeds = ~19.5h total.
# CL-LoRA/EASE/TUNA: NO reliable full-length timing exists -- every prior
# run of these three was truncated to 5-20 tasks for sweep speed, never the
# full grid (up to 100 tasks on OmniBenchmark-1K). This is a real risk, not
# just an unknown: per the ce_profiling_methodology memory's task-count
# scaling taxonomy, CL-LoRA's eval_task is O(T+1) full-backbone-forwards per
# eval image (unbounded, forever), and EASE is WORSE -- O(T^2) proto-forward
# and O(T^3) similarity-loop iterations on top of that. At T=100
# (OmniBenchmark-1K), EASE in particular could plausibly consume a large
# fraction of this entire 160h budget on its own, or not finish within it.
# Datasets are deliberately ordered cheapest-first (sun397 -> imagenetr ->
# cifar224 -> food101 -> omnibenchmark1k) specifically because of this
# uncertainty, and O-LoRA (the confidently-estimated, priority method per
# explicit user request) runs to completion FIRST, before any budget is
# risked on the uncertain methods.
#
# RESUMABLE via scripts/_bankcap_run_done.py (fully generic despite the
# name -- reconstructs trainer.py's own metrics-path formula from a config's
# model_name/dataset/prefix/seed, checks status=="done"; reused verbatim
# from bankcap_wave1_imagenetr20t.slurm / wave1_rerun_treelora.slurm rather
# than duplicated). All 60 configs have final_metrics=true so this check
# applies uniformly, unlike the sweep scripts which needed a checkpoint-count
# fallback.
#
# SINGLE GPU BY CONSTRUCTION: plain sequential loop, CUDA_VISIBLE_DEVICES
# pinned to 0, no worker-pool/FIFO fan-out.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=wave1_final_completion
CONFIG_DIR="exps/$CAMPAIGN"
OUT_DIR="run_logs/$CAMPAIGN"
mkdir -p "$CONFIG_DIR" "$OUT_DIR"

LOCKFILE="$OUT_DIR/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check -- single-GPU by construction, sequential loop,
# same idiom as every other script in this project.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_wave1_final_completion_configs.py
echo "==== config generation done $(date) ===="

run_one() {
  # $1 = path to config json.
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

CONFIG_COUNT=$(ls "$CONFIG_DIR"/*.json 2>/dev/null | wc -l)
echo "==== ${CAMPAIGN} start: ${CONFIG_COUNT} configs (olora rerun + cllora/ease/tuna), single GPU $(date) ===="

SEEDS="1993 1996 1999"
DATASET_ORDER="sun397 imagenetr cifar224 food101 omnibenchmark1k"

# O-LoRA rerun FIRST -- explicit priority (up-to-date memory logging), and
# the only one of the four methods here with a confident wall-time estimate.
echo "-------- O-LORA RERUN (priority) --------"
for dataset in $DATASET_ORDER; do
  for seed in $SEEDS; do
    run_one "$CONFIG_DIR/olora_${dataset}_s${seed}.json"
  done
done

# Then CL-LoRA/EASE/TUNA, method-major, cheapest-dataset-first within each
# (see WALL TIME note above for why this order matters here specifically).
for method in cllora ease tuna; do
  echo "-------- ${method^^} --------"
  for dataset in $DATASET_ORDER; do
    for seed in $SEEDS; do
      run_one "$CONFIG_DIR/${method}_${dataset}_s${seed}.json"
    done
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
