#!/bin/bash
#SBATCH --job-name=slao_sdlora_sun397_food101_rerun_then_omni200t
#SBATCH --time=72:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/slao_sdlora_sun397_food101_rerun_then_omni200t/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/slao_sdlora_sun397_food101_rerun_then_omni200t/slurm_%j.err
#
# Two-phase campaign (2026-11-04 user request):
#
# PHASE 1 -- re-run SLAO and SD-LoRA on SUN397 and Food-101 using the
# CORRECTED per-dataset task splits (sun397: init_cls=37/increment=40;
# food101: init_cls=6/increment=5 -- see
# scripts/gen_slao_sdlora_wave1_datasets_configs.py's 2026-11-04 bug-fix
# docstring). The ORIGINAL slao_sdlora_wave1_datasets.slurm run used a
# hardcoded, never-verified init_cls=10/increment=10 for every dataset,
# silently wrong for these two. All 3 Food-101 seeds and 1 SUN397 seed
# already completed under the WRONG split before this was caught.
#
# PHASE 2 -- chained after phase 1 completes: both methods, 3 seeds, on
# OmniBenchmark-1k-200t (exps/slao_sdlora_wave1_datasets/{slao,sdlora}/
# omnibenchmark1k_200t_s*.json, generated by
# scripts/gen_slao_sdlora_omnibenchmark1k_200t_configs.py -- dataset=
# omnibenchmark1k, init_cls=5/increment=5, per exps/omnibenchmark1k_200t/'s
# own established split). Learning rate is the SAME as the 100t variant
# already uses for this dataset (slao=0.001, sdlora=0.005), per explicit
# user instruction -- 200t was never independently tuned.
#
# CRITICAL -- stale resumability records: the phase-1 configs being re-run
# here keep the EXACT SAME prefix/tag as the original wrong-split run (the
# bug was only in init_cls/increment, not naming), so
# scripts/_bankcap_run_done.py's status=="done" check would see the OLD,
# wrong-split run's final_metrics/ops_ledger files and skip the corrected
# re-run entirely. Before phase 1 starts, this script explicitly deletes
# those specific stale records (sun397/food101 only, both methods, all 3
# seeds) so run_one() is forced to actually redo them. Nothing else is
# touched -- imagenetr/cifar224/omnibenchmark1k's own existing records (all
# unaffected by the split bug) are left alone.
#
# Resumable within each phase via the same run_one()/_bankcap_run_done.py
# pattern as slao_sdlora_wave1_datasets.slurm. If the job hits the wall
# mid-phase-1, resubmitting re-enters phase 1 (finished configs skip in
# seconds) and only proceeds to phase 2 once all of phase 1 shows done.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=slao_sdlora_sun397_food101_rerun_then_omni200t
CONFIG_ROOT="exps/slao_sdlora_wave1_datasets"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- configs are committed to the repo (scripts/gen_slao_sdlora_wave1_datasets_configs.py + scripts/gen_slao_sdlora_omnibenchmark1k_200t_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local method
  local tag
  method="$(basename "$(dirname "$config")")"
  tag="${method}_$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== invalidating stale (wrong-task-split) final_metrics for sun397/food101 $(date) ===="
for METHOD in slao sdlora; do
  for DATASET in sun397 food101; do
    for SEED in 1993 1996 1999; do
      PREFIX="slao_sdlora_wave1_datasets_${METHOD}_${DATASET}_s${SEED}"
      TAG="${METHOD}_${DATASET}_${PREFIX}_s${SEED}"
      STALE_METRICS="run_logs/final/${METHOD}/metrics_${TAG}.json"
      STALE_LEDGER="run_logs/final/${METHOD}/ops_ledger_${TAG}.json"
      if [ -f "$STALE_METRICS" ] || [ -f "$STALE_LEDGER" ]; then
        echo "  removing stale ${TAG}"
        rm -f "$STALE_METRICS" "$STALE_LEDGER"
      fi
    done
  done
done

echo "==== PHASE 1: sun397/food101 re-run, 2 methods x 2 datasets x 3 seeds = 12 runs $(date) ===="
for METHOD in slao sdlora; do
  echo "-------- method: ${METHOD} --------"
  for DATASET in sun397 food101; do
    echo "---- dataset: ${DATASET} ----"
    for cfg in "$CONFIG_ROOT"/"$METHOD"/${DATASET}_s*.json; do
      run_one "$cfg"
    done
  done
done
echo "==== PHASE 1 COMPLETE $(date) ===="

echo "==== PHASE 2: omnibenchmark1k-200t, 2 methods x 3 seeds = 6 runs $(date) ===="
for METHOD in slao sdlora; do
  echo "-------- method: ${METHOD} --------"
  for cfg in "$CONFIG_ROOT"/"$METHOD"/omnibenchmark1k_200t_s*.json; do
    run_one "$cfg"
  done
done
echo "==== PHASE 2 COMPLETE $(date) ===="

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
