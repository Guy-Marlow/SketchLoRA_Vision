#!/bin/bash
#SBATCH --job-name=cllora_ease_tuna_rainbow_lr_refine
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_rainbow_lr_refine/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_rainbow_lr_refine/slurm_%j.err
#
# LR refinement sweep for CL-LoRA/EASE/TUNA/RainbowPrompt (2026-08-11 user
# request) -- a follow-up to the original cllora_ease_tuna_rainbow_sens grid
# (scripts/cllora_ease_tuna_rainbow_sens.slurm), narrowed to explicit LR
# values on the dataset subset each method's earlier sweep flagged as
# unsettled (still improving at the edge of the tested multiplier range, or
# heading the wrong direction for the values tried). Configs:
# exps/cllora_ease_tuna_rainbow_lr_refine/<method>_<dataset>_<lrtag>.json, 47
# total, generated by scripts/gen_cllora_ease_tuna_rainbow_lr_refine_configs.py
# (idempotent -- called fresh below). Architecture/training-loop settings
# (20 epochs, batch 48, each method's own native optimizer, etc.) are
# unchanged from the original sweep -- ONLY lr, dataset subset, and task-count
# truncation differ here.
#
# Grid (single seed 1993, one run per cell):
#   RainbowPrompt: {1e-3, 5e-4, 1e-4} on all 5 datasets                = 15
#   CL-LoRA:       {3e-2, 1e-2, 5e-2} on cifar224/imagenetr/sun397/food101,
#                  {3e-1, 5e-1, 7e-1} on omnibenchmark1k                = 15
#   EASE:          {5e-3, 1e-2, 3e-2} on cifar224/food101/sun397 (no
#                  imagenetr this round), {3e-5, 1e-5} on omnibenchmark1k = 11
#   TUNA:          {5e-3, 8e-3, 1e-2} on imagenetr/omnibenchmark1k only  = 6
#   TOTAL = 47 runs
#
# TASK-COUNT TRUNCATION (explicit user counts, NOT the original sweep's own
# truncation): cifar224 5, sun397 5, food101 8, imagenetr 8, omnibenchmark1k 15
# (of the wave1_final splits' 10/10/20/20/100 tasks respectively).
#
# NO STRUCTURED LOGGING, same rationale/convention as the original sweep: a
# short LR probe only needs the final top-1/top5 CIL number, which
# trainer.py prints unconditionally regardless of final_metrics/print_forget
# -- recoverable straight from each run's own .out log:
#   grep "CNN top5 curve:" run_logs/cllora_ease_tuna_rainbow_lr_refine/<tag>.out
# (last value in that list = final checkpoint's top-5; likewise "CNN top1 curve:").
#
# SINGLE GPU BY CONSTRUCTION, same idiom as the original sweep / wave1_final.slurm:
# a plain sequential loop, CUDA_VISIBLE_DEVICES pinned to 0, no worker-pool/FIFO
# fan-out.
#
# RUN ORDER: method-major, in the order given in the user's request
# (RainbowPrompt -> CL-LoRA -> EASE -> TUNA), then alphabetically by whatever
# config filenames exist for that method (dataset, then lr tag) -- a glob per
# method rather than nested dataset/lr loops, since each method's dataset
# subset and value count are irregular here (CL-LoRA/RainbowPrompt: 5
# datasets; EASE: 4; TUNA: 2), unlike the original sweep's uniform 5x4 grid.
#
# RESUMABLE, same design as the original sweep: no metrics-json status check
# (final_metrics=false means one is never written) -- completion is read
# directly off each run's own .out log instead. A cell whose .out file
# already has "Average Accuracy (CNN):" is skipped; the lockfile still guards
# against a second concurrent instance of this script.
#
# WALL TIME (48h, conservative): each cell trains more tasks than the
# original sweep's truncation (up to 15, vs that sweep's max of 10), so cells
# run longer on average -- not directly measured yet for this specific grid.
# The resumable design means a resubmission just continues from whatever the
# .out logs show incomplete, in the same fixed order, if 48h isn't enough.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/cllora_ease_tuna_rainbow_lr_refine

LOCKFILE="run_logs/cllora_ease_tuna_rainbow_lr_refine/.cllora_ease_tuna_rainbow_lr_refine.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another cllora_ease_tuna_rainbow_lr_refine.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check ONLY -- single-GPU by construction (see header), so
# there is no worker-pool size to derive from this.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless, this script never uses a second device."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_cllora_ease_tuna_rainbow_lr_refine_configs.py
echo "==== config generation done $(date) ===="

CONFIG_DIR="exps/cllora_ease_tuna_rainbow_lr_refine"
OUT_DIR="run_logs/cllora_ease_tuna_rainbow_lr_refine"
METHODS=(rainbowprompt cllora ease tuna)

N_TOTAL=$(ls "$CONFIG_DIR"/*.json 2>/dev/null | wc -l)
echo "==== cllora_ease_tuna_rainbow_lr_refine start: ${N_TOTAL} configs across ${#METHODS[@]} methods, single GPU, single seed (1993), no structured logging $(date) ===="

run_one() {
  # $1=path to config json
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  # No metrics json exists for these runs (final_metrics=false) -- completion
  # is read directly from the .out log's own unconditional final-summary print
  # instead (trainer.py: printed once, after the last checkpoint's CNN top1/
  # top5 curve, only on a run that actually finished).
  if [ -f "$outfile" ] && grep -q "Average Accuracy (CNN):" "$outfile"; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

for METHOD in "${METHODS[@]}"; do
  for CONFIG in $(ls "$CONFIG_DIR/${METHOD}"_*.json 2>/dev/null | sort); do
    run_one "$CONFIG"
  done
done

echo "==== ALL CLLORA_EASE_TUNA_RAINBOW_LR_REFINE RUNS COMPLETE (or wall reached) $(date) ===="
