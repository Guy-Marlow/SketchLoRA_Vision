#!/bin/bash
#SBATCH --job-name=cllora_ease_tuna_rainbow_sens
#SBATCH --time=30:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_rainbow_sens/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_rainbow_sens/slurm_%j.err
#
# LR sensitivity sweep for CL-LoRA/TUNA/EASE/RainbowPrompt (2026-08-05 user
# request): none of these 4 methods have ever had a tuned lr on the wave1_final
# 5-dataset convention -- this grid picks one per method via final top-5 CIL,
# nothing more. 4 methods x 5 datasets x 4 lr multipliers (1x/2x/10x/0.1x of
# each method's current lr) x 1 seed (1993) = 80 runs. Configs:
# exps/cllora_ease_tuna_rainbow_sens/<method>_<dataset>_<lrtag>.json, all 80
# generated by scripts/gen_lr_sweep_configs.py (idempotent -- called fresh
# below). Each method's architecture/training-loop settings (20 epochs, batch
# 48, native optimizer, rank/ffn-dim 10 where that concept is real, prompt
# length left alone -- see that generator's own docstring for the full
# reasoning) are otherwise identical to exps/final/<method>_cifar224_20t.json;
# ONLY lr and dataset/task-count vary across these 80 cells.
#
# TRUNCATED, NOT full splits (explicit user counts, short sweep cells only --
# NOT comparable to wave1_final's full-length runs on the same datasets):
# cifar224 3 tasks, imagenetr 5 tasks, sun397 3 tasks, food101 4 tasks,
# omnibenchmark1k 10 tasks (of 10/20/10/20/100 respectively).
#
# NO STRUCTURED LOGGING (explicit user request -- "we don't need any logging
# enabled... we simply need the hyperparameters and the final top-5 CIL"):
# every config has final_metrics=false, print_forget=false, so no
# MetricsLogger/CE-ledger overhead runs at all. trainer.py prints the CNN
# top1/top5 curve and "Average Accuracy (CNN)" UNCONDITIONALLY regardless of
# those flags (see trainer.py's checkpoint-eval block), so the number this
# sweep actually needs -- final top-5 CIL -- is still fully recoverable
# straight from each run's own .out log:
#   grep "CNN top5 curve:" run_logs/cllora_ease_tuna_rainbow_sens/<tag>.out
# (last value in that list = final checkpoint's top-5).
#
# SINGLE GPU BY CONSTRUCTION, same idiom as scripts/wave1_final.slurm: a
# plain sequential loop, CUDA_VISIBLE_DEVICES pinned to 0, no worker-pool/FIFO
# fan-out.
#
# RUN ORDER: method-major (CL-LoRA -> TUNA -> EASE -> RainbowPrompt), then
# dataset (cifar224 -> imagenetr -> sun397 -> food101 -> omnibenchmark1k,
# matching the order given in the request), then lr tag
# (1x -> 2x -> 10x -> 0.1x) innermost. No phase split -- unlike
# wave1_final.slurm, every cell here is short by construction (truncated task
# counts, no logging overhead), so there's no single dominant-cost dataset to
# wall off the way OmniBenchmark-1k was there.
#
# RESUMABLE, but NOT via a metrics-json status check (final_metrics=false means
# one is never written) -- completion is read directly off each run's own .out
# log instead: trainer.py prints "Average Accuracy (CNN):" exactly once, right
# after the final checkpoint's CNN top1/top5 curve, and only if eval actually
# completed for the last configured task. A cell whose .out file already has
# that line is skipped; the lockfile still guards against a second concurrent
# instance of this script.
#
# WALL TIME (30h, explicit user figure): each cell is short by design
# (truncated tasks, no logging overhead), but this has not been directly
# measured for these 4 methods at 20 epochs/task the way the wave1_final
# methods have been -- if actual per-cell time runs higher than expected,
# the resumable design above means a resubmission just continues from
# whatever the .out logs show incomplete, in the same fixed order.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/cllora_ease_tuna_rainbow_sens

LOCKFILE="run_logs/cllora_ease_tuna_rainbow_sens/.cllora_ease_tuna_rainbow_sens.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another cllora_ease_tuna_rainbow_sens.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check ONLY -- single-GPU by construction (see header), so
# there is no worker-pool size to derive from this.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless, this script never uses a second device."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_lr_sweep_configs.py
echo "==== config generation done $(date) ===="

METHODS=(cllora tuna ease rainbowprompt)
DATASETS=(cifar224 imagenetr sun397 food101 omnibenchmark1k)
LR_TAGS=(1x 2x 10x 0.1x)

echo "==== cllora_ease_tuna_rainbow_sens start: ${#METHODS[@]} methods x ${#DATASETS[@]} datasets x ${#LR_TAGS[@]} lr multipliers = $(( ${#METHODS[@]} * ${#DATASETS[@]} * ${#LR_TAGS[@]} )) runs, single GPU, single seed (1993), no structured logging $(date) ===="

run_one() {
  # $1=method $2=dataset $3=lr_tag
  local method="$1" dataset="$2" lr_tag="$3"
  local tag="${method}_${dataset}_${lr_tag}"
  local config="exps/cllora_ease_tuna_rainbow_sens/${tag}.json"
  local outfile="run_logs/cllora_ease_tuna_rainbow_sens/${tag}.out"

  if [ ! -f "$config" ]; then
    echo "==== SKIP (no config) ${tag} $(date) ===="
    return
  fi
  # No metrics json exists for these runs (final_metrics=false) -- completion
  # is read directly from the .out log's own unconditional final-summary print
  # instead (trainer.py: printed once, after the last checkpoint's CNN top1/
  # top5 curve, only on a run that actually finished).
  if [ -f "$outfile" ] && grep -q "Average Accuracy (CNN):" "$outfile"; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

for METHOD in "${METHODS[@]}"; do
  for DATASET in "${DATASETS[@]}"; do
    for LR_TAG in "${LR_TAGS[@]}"; do
      run_one "$METHOD" "$DATASET" "$LR_TAG"
    done
  done
done

echo "==== ALL CLLORA_EASE_TUNA_RAINBOW_SENS RUNS COMPLETE (or wall reached) $(date) ===="
