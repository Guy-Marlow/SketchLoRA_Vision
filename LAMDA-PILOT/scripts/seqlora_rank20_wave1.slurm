#!/bin/bash
#SBATCH --job-name=seqlora_rank20_wave1
#SBATCH --time=72:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/seqlora_rank20_wave1/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/seqlora_rank20_wave1/slurm_%j.err
#
# SeqLoRA (sequential finetuning) at lora_rank=20, across all five
# wave1_final master-table datasets, 3 seeds each (2026-11-03 user request)
# -- a rank ablation against the project's standing rank-10 SeqLoRA
# reference (exps/wave1_final/seqlora_*). Every other hyperparameter
# (init_lr, init_cls/increment, tuned_epoch, batch_size, weight_decay,
# lora_merge) is identical per dataset to that reference -- only lora_rank
# changes.
#
# 5 datasets x 3 seeds = 15 runs.
#
# Configs are STATIC (exps/seqlora_rank20_wave1/, 15 files, generated by
# scripts/gen_seqlora_rank20_wave1_configs.py -- committed, not regenerated
# at runtime).
#
# Resumable: run_one() skips any config whose own final_metrics JSON
# (run_logs/final/seqlora/metrics_<tag>.json) already shows status=="done"
# (scripts/_bankcap_run_done.py) -- if the job hits the wall, resubmit and
# finished runs skip in seconds. Each config's prefix is tagged
# "seqlora_rank20_wave1_<dataset>_s<seed>", distinct from the rank-10
# reference's own "wave1_final_seqlora_<dataset>_s<seed>" tag, so the two
# can never collide or be mistaken for each other's "done" record.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=seqlora_rank20_wave1
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 15 configs are committed to the repo (scripts/gen_seqlora_rank20_wave1_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local tag
  tag="seqlora_$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 15 runs (1 method x 5 datasets x 3 seeds) $(date) ===="

# dataset-major, ordered cheapest/most-measured first (imagenetr, cifar224
# -- both well-understood on this machine already) before the three
# others, omnibenchmark1k last as the largest; seed-minor.
for DATASET in imagenetr cifar224 food101 sun397 omnibenchmark1k; do
  echo "---- dataset: ${DATASET} ----"
  for cfg in "$CONFIG_ROOT"/${DATASET}_s*.json; do
    run_one "$cfg"
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
