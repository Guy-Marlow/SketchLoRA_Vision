#!/bin/bash
#SBATCH --job-name=ce_final_all
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/ce_final_all/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/ce_final_all/slurm_%j.err
#
# CE (computational efficiency) FINAL evaluation campaign (2026-08-31 user
# request): a from-scratch replacement for ce_eval_wave1_imagenetr20t.slurm,
# not a continuation of it -- see scripts/gen_ce_final_all_configs.py's own
# docstring for the full reasoning, but in short: that campaign's resumable
# skip logic reused 2026-08-22 results for 5 methods on its 2026-08-30
# resubmission with zero awareness that the underlying code had moved on in
# the 9 days between -- a fresh campaign name/prefix makes that impossible
# by construction, since nothing here can match an old metrics file.
#
# PROJECT POLICY: CE1 (legacy OpsLedger) is obsolete and must never be used
# -- CE2 (ce2_enabled=true) is the only relevant CE metric, for every
# method. Every config here sets ce2_enabled=true.
#
# 9 runs, one per method, single seed (1993). Configs:
# exps/ce_final_all/<method>_s1993.json, generated by
# scripts/gen_ce_final_all_configs.py (idempotent, called fresh below).
#
# HOST MEMORY (carried over from ce_eval_wave1_imagenetr20t's own postmortem
# -- see that script for the full evidence): --mem=64G was NOT enough under
# ce2_enabled there -- 4 of 9 methods were silently SIGKILLed by a SLURM/
# cgroup OOM kill (confirmed via that job's own "Detected N oom_kill events"
# .err message; no Python exception, no CUDA OOM -- host RAM, not GPU VRAM).
# --mem raised to 128G here -- user-specified 2026-08-31, on the
# understanding the cluster will not grant more than that. If OOM kills
# recur even at 128G, the next step is checking actual peak RSS via
# `sacct -j <jobid> --format=MaxRSS` (not just inferring from these logs)
# before requesting further.
#
# ALL OUTPUT STAYS UNDER run_logs/ce_final_all/ (2026-08-31 user requirement
# -- a single `scp -r run_logs/ce_final_all` from the cluster should pull
# EVERYTHING, no separate hunt for files written elsewhere):
#   - .out/.err text logs (this script's own OUT_DIR, as before)
#   - the SLURM driver's own slurm_%j.{out,err} (via #SBATCH --output/--error
#     above, same convention as always)
#   - the actual CE2 JSON results -- these are NOT natively written here.
#     trainer.py hardcodes CE2Logger's output to run_logs/ce2/<model_name>/
#     project-wide, with no config field able to redirect it (the same
#     constraint the regular final_metrics JSON has, see
#     scripts/_bankcap_run_done.py's own docstring). scripts/
#     _move_ce2_output.py reconstructs the exact tag trainer.py used
#     (model/dataset/prefix/seed -- same formula _bankcap_run_done.py
#     already relies on) and MOVES the resulting file into
#     run_logs/ce_final_all/ce2/<model_name>/ right after every run_one()
#     attempt, whether it succeeded or not (no-op, exit 0, if ce2_enabled is
#     false or the source file doesn't exist -- e.g. a run that crashed
#     before CE2Logger ever wrote anything).
#
# RESUMABLE via scripts/_bankcap_run_done.py (checks run_logs/final/
# <model>/metrics_<tag>.json's own status=="done" -- reused verbatim; safe
# here specifically because this campaign's own prefix is new, so it can
# only ever match a genuine ce_final_all attempt, never an old campaign's
# leftover file).
#
# A retry's plain `>` would silently overwrite a prior failed attempt's log
# (this bit ce_eval_wave1_imagenetr20t: job 22604's retries destroyed job
# 22507's original O-LoRA/RainbowPrompt logs, making the first failure
# unexaminable) -- run_one() below backs up any existing outfile first.
#
# SINGLE GPU BY CONSTRUCTION: plain sequential loop, CUDA_VISIBLE_DEVICES
# pinned to 0, no worker-pool/FIFO fan-out.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=ce_final_all
CONFIG_DIR="exps/$CAMPAIGN"
OUT_DIR="run_logs/$CAMPAIGN"
CE2_DEST="$OUT_DIR/ce2"
mkdir -p "$CONFIG_DIR" "$OUT_DIR" "$CE2_DEST"

LOCKFILE="$OUT_DIR/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check -- single-GPU by construction, sequential loop,
# same idiom as every other script in this project.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_ce_final_all_configs.py
echo "==== config generation done $(date) ===="

run_one() {
  # $1 = path to config json.
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
  else
    if [ -f "$outfile" ]; then
      mv "$outfile" "${outfile}.prev-${SLURM_JOB_ID:-unknown}"
    fi
    echo "==== START ${tag} $(date) ===="
    python main.py --config "$config" \
      > "$outfile" 2>&1 || true
    echo "==== DONE  ${tag} $(date) ===="
  fi
  # Always attempt the CE2-json relocation, skip or run: a skip means an
  # earlier attempt already finished training but may have been interrupted
  # (job killed, scp'd mid-copy, etc.) before this move step ran for it.
  # No-op if there's nothing to move (see scripts/_move_ce2_output.py).
  python scripts/_move_ce2_output.py "$config" "$CE2_DEST" 2>/dev/null || true
}

# 5 already-precedented, well-behaved methods first; the 4 that OOM-killed
# under ce_eval_wave1_imagenetr20t next (O-LoRA/TUNA/EASE each made real
# partial progress there and should finish given more headroom); RainbowPrompt
# LAST -- it's the one that both failed fastest (task 0, ~3 min in) and took
# the whole SLURM job down with it there, so if it fails again here despite
# the --mem bump, everything else has already banked its results first.
METHOD_ORDER="seqlora inflora treelora sketchlora cllora olora tuna ease rainbowprompt"

echo "==== ${CAMPAIGN} start: 9 methods x 1 seed, single GPU $(date) ===="

for METHOD in $METHOD_ORDER; do
  run_one "$CONFIG_DIR/${METHOD}_s1993.json"
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
