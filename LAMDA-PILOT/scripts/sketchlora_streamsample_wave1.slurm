#!/bin/bash
#SBATCH --job-name=sketchlora_streamsample_wave1
#SBATCH --time=20:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_streamsample_wave1/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_streamsample_wave1/slurm_%j.err
#
# Boundary-agnostic sample-count streaming campaign, wave 1 (2026-10-29 user
# request): canonical SketchLoRA (sketchlora_align, merge_op="qrsvd",
# sketchlora_align_mode="orth", weight=0.5 -- the unqualified "SketchLoRA"
# convention since 2026-10-28) evaluated under models/stream_mixin.py::
# stream_run's REPAIRED unique-image-budget design (boundary_mode="sample",
# stream_chunk_samples=N) -- real task boundaries exist in the data but
# training proceeds on fixed-size disjoint chunks, irrespective of where
# those boundaries fall. NOT the faulty epoch-repeated-sample-count clock
# (boundary_mode="sample_legacy") -- see trainer.py lines 99-113 for the
# dispatch.
#
# Verified via a 3-task/200-sample-chunk smoke test (exps/smoke/
# sketchlora_align_sample_stream_test.json, 2026-10-29) that the chunking
# dispatches correctly AND that models/sketchlora_align.py's
# _stream_extra_loss override (added this session -- previously MISSING,
# so every prior streaming-mode sketchlora_align run silently trained with
# NO orthogonality penalty) is genuinely wired in and active from the 2nd
# chunk onward.
#
# 2 datasets x 3 chunk sizes (500/1000/1500 images) x 3 seeds
# (1993/1996/1999) = 18 runs:
#   - imagenetr: full 20-task regime (init_cls=10/increment=10, no
#     stop_after_tasks), init_lr=2e-3 (this session's top-1% LR-sweep
#     winner, decisive over the full 7e-4..3e-3 grid)
#   - cifar224: full 10-task regime, init_lr=9e-4 (best-so-far from the
#     same sweep -- that search was cut short before fully resolving
#     8e-4 vs 9e-4, which were tied; not a fully decided optimum)
# Both tuned_epoch=20/batch_size=48/weight_decay=0.0005/lora_rank=10,
# matching the LR-sweep's own source configs.
#
# Configs are STATIC (exps/sketchlora_streamsample_wave1/, 18 files,
# generated by scripts/gen_sketchlora_streamsample_wave1_configs.py --
# committed, not regenerated at runtime, matching armd_vs_sketchlora.
# slurm's convention).
#
# WALL TIME: streaming mode's per-chunk cost in the smoke test was ~24s/
# chunk at chunk=200 (3 tasks, 21 chunks, ~8.5 min total) on this
# project's A5000; chunk cost scales with its own image count, not purely
# per-step count, so larger chunks aren't proportionally cheaper per
# chunk, but DO mean fewer chunks overall for the same total image count.
# Full-regime image counts (~26-27k/imagenetr, ~50k/cifar224) make every
# cell here far larger than the smoke test regardless of chunk size --
# budget generously. 20h requested for headroom across all 18 runs.
# Resumable: run_one() skips any config whose own run_logs/stream_...
# JSON already shows partial=false (scripts/_stream_run_done.py) -- if the
# job hits the wall, resubmit and finished runs skip in seconds.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=sketchlora_streamsample_wave1
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 18 configs are committed to the repo (scripts/gen_sketchlora_streamsample_wave1_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_stream_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 18 runs (2 datasets x 3 chunk sizes x 3 seeds) $(date) ===="

# dataset-major (cheaper imagenetr chunk work first within comparable chunk
# sizes isn't really orderable by cost here since both datasets run their
# full native regime), chunk-size-major within dataset (smallest-chunk/
# most-chunks runs first, so a wall-clock cutoff still yields a complete
# small-chunk picture rather than large-chunk runs finishing while small-
# chunk ones are left totally unstarted), seed-minor.
for DATASET in imagenetr cifar224; do
  echo "-------- dataset: ${DATASET} --------"
  for CHUNK in 500 1000 1500; do
    echo "---- chunk size: ${CHUNK} ----"
    for cfg in "$CONFIG_ROOT"/"$DATASET"/chunk${CHUNK}_s*.json; do
      run_one "$cfg"
    done
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
