#!/bin/bash
#SBATCH --job-name=sketchlora_streamsample_wave1
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_streamsample_wave1/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_streamsample_wave1/slurm_%j.err
#
# Boundary-agnostic sample-count streaming campaign, wave 1 (2026-10-29 user
# request): canonical SketchLoRA (sketchlora_align, merge_op="qrsvd",
# sketchlora_align_mode="orth", weight=0.5 -- the unqualified "SketchLoRA"
# convention since 2026-10-28) evaluated under models/stream_mixin.py::
# stream_run's REPAIRED unique-image-budget design (boundary_mode="sample",
# stream_chunk_samples=N) -- real task boundaries exist in the data but
# training proceeds on fixed-size disjoint chunks, irrespective of where
# those boundaries fall. NOT the faulty epoch-repeated-sample-count clock
# (boundary_mode="sample_legacy") -- see trainer.py lines 99-113 for the
# dispatch.
#
# Verified via a 3-task/200-sample-chunk smoke test (exps/smoke/
# sketchlora_align_sample_stream_test.json, 2026-10-29) that the chunking
# dispatches correctly AND that models/sketchlora_align.py's
# _stream_extra_loss override (added this session -- previously MISSING,
# so every prior streaming-mode sketchlora_align run silently trained with
# NO orthogonality penalty) is genuinely wired in and active from the 2nd
# chunk onward.
#
# 2026-11-02 EXTENDED, twice (separate request from the SLAO/SD-LoRA oracle
# campaign below -- this one is SketchLoRA-only, testing how SketchLoRA
# itself performs under the stream-sample setting, NOT a comparison that
# runs SLAO/SD-LoRA under streaming at all):
#   - cifar224: chunk 500/1000/1500 (already complete) PLUS NEW chunk
#     2000/2500
#   - omnibenchmark1k: entirely NEW, all 5 chunk sizes (500/1000/1500/
#     2000/2500) -- never run under this campaign before. 100-task
#     dataset (~10x cifar224's task count); its full-regime image count
#     could not be confirmed locally (data not downloaded on this
#     machine) before these configs were built -- treat the wall-time
#     estimate below as a rough floor, not a measurement.
#   - imagenetr: initially left at its original chunk 500/1000/1500
#     (already complete as of 2026-10-31), then ALSO extended to
#     2000/2500 per a follow-up request the same day -- all three
#     datasets now share the identical 5-size grid.
# Total: 15 (imagenetr, 5 sizes x 3 seeds) + 15 (cifar224, 5 sizes x 3
# seeds) + 15 (omnibenchmark1k, 5 sizes x 3 seeds) = 45 runs.
# init_lr=1e-3 on ALL THREE datasets (2026-10-30: matches exps/
# sketchlora_orth_wave1_datasets/'s own master-table LR convention, not
# any dataset's top-1%-tuned LR-sweep winner -- avoids introducing a
# second variable alongside the streaming-vs-oracle comparison this
# campaign is actually testing; confirmed exps/wave1_final/
# sketchlora_omnibenchmark1k_s1993.json already uses the same 1e-3, so
# this isn't a new LR decision for omnibenchmark1k either).
# All tuned_epoch=20/batch_size=48/weight_decay=0.0005/lora_rank=10,
# matching the wave1/LR-sweep source configs.
#
# Configs are STATIC (exps/sketchlora_streamsample_wave1/, 39 files,
# generated by scripts/gen_sketchlora_streamsample_wave1_configs.py --
# committed, not regenerated at runtime, matching armd_vs_sketchlora.
# slurm's convention).
#
# WALL TIME: the original 18-run scope (imagenetr+cifar224, chunk 500-
# 1500) measured ~12.5h actual on this cluster (2026-10-31 run, well
# under the 20h that was budgeted then). omnibenchmark1k's real per-run
# cost is UNMEASURED on this machine (100 tasks vs cifar224's 10) -- 48h
# requested as a conservative floor, not a verified estimate; this may
# still need bumping once the first omnibenchmark1k run's actual duration
# is known. Resumable: run_one() skips any config whose own
# run_logs/stream_...JSON already shows partial=false
# (scripts/_stream_run_done.py) -- if the job hits the wall, resubmit and
# finished runs skip in seconds. Dataset-major, cheapest-first (imagenetr
# -> cifar224 -> omnibenchmark1k), so a wall-clock cutoff still leaves the
# two cheaper datasets complete rather than every dataset partially done.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=sketchlora_streamsample_wave1
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 18 configs are committed to the repo (scripts/gen_sketchlora_streamsample_wave1_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local dataset
  local tag
  # 2026-11-02 BUG FIX: tag used to be just the config's own basename
  # (e.g. "chunk500_s1993"), which collides across the two datasets --
  # exps/sketchlora_streamsample_wave1/{imagenetr,cifar224}/chunk500_s1993.json
  # both produced "chunk500_s1993.out" in the SAME flat $OUT_ROOT, so
  # cifar224's run (started after every imagenetr run per the dataset-major
  # loop below) silently overwrote imagenetr's .out text for every matching
  # chunk/seed pair. Confirmed on the actual 2026-10-31 cluster run: all 9
  # imagenetr .out files were destroyed this way (only cifar224's content
  # survived). The runs' own structured JSON results were NOT affected --
  # _run_stream's own filename is built from args["prefix"], which already
  # includes the dataset -- only this script's raw-log naming was broken.
  dataset="$(basename "$(dirname "$config")")"
  tag="${dataset}_$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_stream_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 45 runs (imagenetr/cifar224/omnibenchmark1k, 5 sizes each, x 3 seeds) $(date) ===="

# dataset-major, cheapest-and-most-complete first (imagenetr -> cifar224 ->
# omnibenchmark1k, the latter entirely unmeasured and likely the most
# expensive by far -- see WALL TIME note above), chunk-size-major within
# dataset (smallest-chunk/most-chunks runs first, so a wall-clock cutoff
# still yields a complete small-chunk picture rather than large-chunk runs
# finishing while small-chunk ones are left totally unstarted), seed-minor.
# All three datasets now share the identical 5-size grid (imagenetr was
# extended to match cifar224/omnibenchmark1k after a follow-up request).
declare -A CHUNKS_FOR
CHUNKS_FOR[imagenetr]="500 1000 1500 2000 2500"
CHUNKS_FOR[cifar224]="500 1000 1500 2000 2500"
CHUNKS_FOR[omnibenchmark1k]="500 1000 1500 2000 2500"

for DATASET in imagenetr cifar224 omnibenchmark1k; do
  echo "-------- dataset: ${DATASET} --------"
  for CHUNK in ${CHUNKS_FOR[$DATASET]}; do
    echo "---- chunk size: ${CHUNK} ----"
    for cfg in "$CONFIG_ROOT"/"$DATASET"/chunk${CHUNK}_s*.json; do
      run_one "$cfg"
    done
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
