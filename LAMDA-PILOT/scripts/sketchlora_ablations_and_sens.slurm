#!/bin/bash
#SBATCH --job-name=sketchlora_ablations_and_sens
#SBATCH --time=30:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_ablations_and_sens/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_ablations_and_sens/slurm_%j.err
#
# SketchLoRA ablations-and-sensitivity campaign (2026-08-05 user request).
# ImageNet-R, FULL 20-task oracle split (init_cls=10/increment=10, no
# stop_after_tasks -- this is a real evaluation, not a truncated sweep),
# rank-10/batch-48/tuned_epoch-20 convention, 3 seeds (1993/1996/1999).
# 45 runs total, all generated by scripts/gen_sketchlora_ablations_and_sens_
# configs.py (idempotent, called fresh below) into
# exps/sketchlora_ablations_and_sens/<subdir>/ -- see that script's own
# docstring for the full per-item HP reasoning, not re-derived here. THREE
# sub-experiments, all sharing sketchlora_admission=bounded_eviction and
# sketchlora_rank_cap=null (no cap, every cell in this campaign):
#   1. reduce_merge_sens (6 runs): canonical (merge_op=randsvd) vs. the new
#      reduce_merge ablation, eps=0.01, otherwise identical -- isolates the
#      merge-order axis alone.
#   2. period_sens (9 runs): svd_period in {2,5,10}, eps=0.01. lora_n_slots
#      is set to period+1 per variant (a hard requirement -- see the config
#      generator's docstring for the verification done before committing to
#      this: routing/fold-cadence/rank-selection all confirmed correct via a
#      real 5-task local smoke test at period=2 before this campaign was
#      built, not assumed from a code read alone).
#   3. epsilon_sens (30 runs): svd_energy_target in
#      {0.05,0.045,0.04,0.035,0.03,0.025,0.02,0.015,0.005,0.0}. 0.01 excluded
#      (already have sketchlora_ablations_imagenetr20t's "current" data at
#      that value). eps=0.0 confirmed to run without error via a local smoke
#      test before being included here (rather than assumed safe).
#
# WALL TIME -- READ BEFORE SUBMITTING: 30h was the user's given figure, but
# this campaign's cells are the SAME shape (ImageNet-R 20-task/20-epoch
# oracle SketchLoRA) as the existing sketchlora_ablations_imagenetr20t
# campaign, whose own script recorded a "~144h full-completion estimate for
# all 18 runs sequentially on one GPU" (~8h/run average) -- but the user's
# OWN measured figure for this specific campaign's cells is ~25min/run
# (~19h total for all 45), which is what the 30h allocation is actually sized
# against. Flagging the discrepancy with the older estimate rather than
# silently picking one: if actual per-run cost lands closer to the older
# campaign's 8h, only a handful of cells will complete per submission. The
# resumable design below (same convention as every other script in this
# project) handles either case safely either way.
#
# LOGGING CONFLICTS -- explicit user requirement. final_metrics=true's
# metrics_*.json/ops_ledger_*.json land in the SHARED run_logs/final/
# sketchlora/ (hardcoded there by trainer.py/utils/metrics_logger.py/utils/
# ops_ledger.py, not configurable per-script -- same situation as
# scripts/wave1_final.slurm) and are moved into this campaign's own
# run_logs/sketchlora_ablations_and_sens/<subdir>/final/sketchlora/ right
# after each run finishes -- those filenames are already unique per run
# (built from each config's own unique `prefix`), so a plain move suffices,
# no cross-campaign risk.
#
# sketchlora_diag_*.json is the case that actually needed fixing (2026-08-05,
# user-caught): by default its filename is built from (dataset,
# svd_energy_target, n_lora_blocks, split, seed) -- NOTHING in that tuple
# depends on merge_op or svd_period, so every reduce_merge_sens/period_sens
# cell at eps=0.01 would share one filename, AND -- the real problem, a
# write-then-move can't close this -- scripts/wave1_final.slurm is running
# concurrently on the cluster and its own SketchLoRA/ImageNet-R cells ALSO
# use eps=0.01, targeting that exact same shared default path from a
# completely independent, uncoordinated job. Fixed at the source, not
# papered over with a move: every config in this campaign sets
# sketchlora_diag_dir (models/sketchlora.py, new opt-in field) to
# run_logs/sketchlora_ablations_and_sens/<subdir>/diag/, keyed by this run's
# own globally-unique `prefix` -- the diag JSON lands at its final location
# the moment it's written, never touching the shared path this campaign's
# runs would otherwise contend with wave1_final over. wave1_final itself
# needed no changes: it still defaults to the old shared-path behavior,
# which is now uncontested again since this campaign no longer targets it.
#
# SINGLE GPU BY CONSTRUCTION, same idiom as scripts/wave1_final.slurm /
# scripts/cllora_ease_tuna_rainbow_sens.slurm: a plain sequential loop,
# CUDA_VISIBLE_DEVICES pinned to 0, no worker-pool/FIFO fan-out.
#
# RUN ORDER: item 1 -> item 2 -> item 3 (the user's own numbered priority),
# variant-major within each item, seeds 1993 -> 1996 -> 1999 innermost (so a
# variant's full 3-seed set finishes before the next variant starts, giving
# usable non-partial data sooner). No phase-splitting beyond that ordering --
# unlike wave1_final.slurm's OmniBenchmark-1k isolation, there's no single
# cell here that's dramatically more expensive than the rest to wall off.
#
# RESUMABLE / LOCKFILE: same convention as every other script in this
# project -- skips a cell whose (already-moved) metrics json shows
# "status": "done"; refuses to start a second instance of itself.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/sketchlora_ablations_and_sens

LOCKFILE="run_logs/sketchlora_ablations_and_sens/.sketchlora_ablations_and_sens.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another sketchlora_ablations_and_sens.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check ONLY -- single-GPU by construction (see header), so
# there is no worker-pool size to derive from this.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless, this script never uses a second device."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_sketchlora_ablations_and_sens_configs.py
echo "==== config generation done $(date) ===="

SEEDS=(1993 1996 1999)

run_one() {
  # $1=subdir $2=variant $3=seed
  local subdir="$1" variant="$2" seed="$3"
  local tag="${variant}_s${seed}"
  local config="exps/sketchlora_ablations_and_sens/${subdir}/${tag}.json"
  local prefix="sketchlora_ablations_and_sens_${subdir}_${tag}"
  # oracle path (trainer.py: _tag = "{model_name}_{dataset}_{prefix}_s{seed}"),
  # same formula every other final_metrics-gated script in this project uses;
  # prefix already ends in _s<seed> (see the config generator), so the seed
  # suffix is doubled in the metrics filename -- expected, matches the
  # existing convention elsewhere (e.g. wave1_final.slurm).
  local metrics_tag="sketchlora_imagenetr_${prefix}_s${seed}"

  local final_dir="run_logs/sketchlora_ablations_and_sens/${subdir}/final/sketchlora"
  mkdir -p "$final_dir"
  local metrics_json="${final_dir}/metrics_${metrics_tag}.json"
  local ops_ledger_json="${final_dir}/ops_ledger_${metrics_tag}.json"
  local src_final_dir="run_logs/final/sketchlora"
  local src_metrics="${src_final_dir}/metrics_${metrics_tag}.json"
  local src_ops_ledger="${src_final_dir}/ops_ledger_${metrics_tag}.json"
  local outfile="run_logs/sketchlora_ablations_and_sens/${subdir}/${tag}.out"

  if [ ! -f "$config" ]; then
    echo "==== SKIP (no config) ${prefix} $(date) ===="
    return
  fi
  if [ -f "$metrics_json" ] && grep -q '"status": "done"' "$metrics_json"; then
    echo "==== SKIP (done) ${prefix} $(date) ===="
    return
  fi
  echo "==== START ${prefix} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${prefix} $(date) ===="

  # -f guards: a crashed/incomplete run may not have produced these at all.
  [ -f "$src_metrics" ] && mv -f "$src_metrics" "$metrics_json"
  [ -f "$src_ops_ledger" ] && mv -f "$src_ops_ledger" "$ops_ledger_json"

  # sketchlora_diag: NO move step needed. Each config's own
  # "sketchlora_diag_dir" field (set by the config generator to
  # run_logs/sketchlora_ablations_and_sens/<subdir>/diag) points
  # models/sketchlora.py's _diag_path straight at its final location, so the
  # JSON lands there as soon as it's written -- avoids the cross-campaign
  # collision a write-then-move approach can't fully close (the shared
  # default path is also being written concurrently by
  # scripts/wave1_final.slurm on the cluster right now). models/sketchlora.py
  # creates that directory itself (os.makedirs in _record_diag) -- nothing
  # needed here.
}

echo "==== ITEM 1: reduce_merge_sens start $(date) ===="
for VARIANT in canonical reduce_merge; do
  for SEED in "${SEEDS[@]}"; do
    run_one "reduce_merge_sens" "$VARIANT" "$SEED"
  done
done
echo "==== ITEM 1: reduce_merge_sens complete (or wall reached) $(date) ===="

echo "==== ITEM 2: period_sens start $(date) ===="
for VARIANT in period2 period5 period10; do
  for SEED in "${SEEDS[@]}"; do
    run_one "period_sens" "$VARIANT" "$SEED"
  done
done
echo "==== ITEM 2: period_sens complete (or wall reached) $(date) ===="

echo "==== ITEM 3: epsilon_sens start $(date) ===="
for VARIANT in eps0.05 eps0.045 eps0.04 eps0.035 eps0.03 eps0.025 eps0.02 eps0.015 eps0.005 eps0.0; do
  for SEED in "${SEEDS[@]}"; do
    run_one "epsilon_sens" "$VARIANT" "$SEED"
  done
done
echo "==== ITEM 3: epsilon_sens complete (or wall reached) $(date) ===="

echo "==== ALL SKETCHLORA_ABLATIONS_AND_SENS RUNS COMPLETE (or wall reached) $(date) ===="
