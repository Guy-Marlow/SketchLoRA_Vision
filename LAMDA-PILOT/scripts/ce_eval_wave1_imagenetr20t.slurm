#!/bin/bash
#SBATCH --job-name=ce_eval_wave1_imagenetr20t
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/ce_eval_wave1_imagenetr20t/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/ce_eval_wave1_imagenetr20t/slurm_%j.err
#
# CE (computational efficiency) evaluation campaign (2026-08-20 user
# request): single-seed ImageNet-R-20t run for each of the 9 wave-1 methods
# with full CE/CE2 logging enabled, to conclusively compare real MAC cost
# across methods over a 20-task horizon. Follows a 9-agent CE-logging audit
# (one agent per method) -- see scripts/gen_ce_eval_wave1_imagenetr20t_
# configs.py's own docstring for the full findings and the caveats on how
# to read this campaign's numbers (do not drop those caveats when reporting
# results).
#
# PROJECT POLICY (2026-08-20, explicit user directive): CE1 (legacy
# OpsLedger) is obsolete and must never be used -- CE2 (ce2_enabled=true) is
# the only relevant CE metric, for every method, going forward. Every
# config here sets ce2_enabled=true; verified directly against
# trainer.py:144,197-198,214-215 that this guarantees CE1 is never
# constructed for ANY of the 9 methods (not inferred, confirmed from
# source). This is not a fallback for the 4 methods that lack
# `_train_adapter` -- it is the exclusive CE mechanism for all 9, including
# the 5 that would otherwise also qualify for CE1. Standard wave-1 logging
# (persistent memory, top-1/top-5 CIL accuracy, forgetting) is unrelated to
# this switch and stays on via each config's own final_metrics/print_forget,
# carried over unchanged from its source config.
#
# 9 runs, one per method, single seed (1993) -- this campaign answers "how
# expensive is each method," not a statistical accuracy comparison.
# Configs: exps/ce_eval_wave1_imagenetr20t/<method>_s1993.json, generated by
# scripts/gen_ce_eval_wave1_imagenetr20t_configs.py (idempotent, called
# fresh below). Settled learning rates carried over verbatim from
# exps/wave1_final/ (seqlora/inflora/treelora/sketchlora/rainbowprompt) and
# exps/wave1_final_completion/ (olora -- current-code rerun, 2026-08-30
# update; cllora/tuna/ease).
#
# WALL TIME -- FLAGGED, GENUINELY UNCERTAIN, READ BEFORE ASSUMING THIS FITS.
# The 5 LoRA-scaffold methods (O-LoRA/SeqLoRA/InfLoRA/TreeLoRA/SketchLoRA)
# have real precedent timing on this project's clusters (~28-32 min each for
# a full ImageNet-R-20t run, per bankcap_wave1_imagenetr20t_campaign
# memory) -- but that precedent is WITHOUT ce2_enabled, which wraps every
# incremental_train()/eval_task() call in a torch.profiler session and will
# add real overhead on top, not measured here. The other 4 methods
# (RainbowPrompt/CL-LoRA/TUNA/EASE) have NEVER been run with any FLOPs-level
# profiling active before this campaign, AND per the audit, EASE's config
# here has recalc_sim=true, which the audit confirmed makes its
# similarity-loop genuinely O(T^3) cumulative over a 20-task run -- with
# profiler overhead on top of an already up-to-cubic-scaling cost, EASE is
# the single biggest wall-time risk in this campaign by a wide margin. Run
# order below is deliberately ordered by ascending risk/uncertainty (cheap,
# well-precedented methods first; EASE last) so a wall-time cutoff secures
# the confident, cheap results before spending budget on the riskiest one.
# Resubmit if EASE (or the campaign generally) doesn't finish in one pass --
# resumable design below handles that safely.
#
# HOST MEMORY -- UPDATE (2026-08-31, first two submissions examined after the
# user moved the raw outputs to a local folder): the wall-time risk above
# didn't end up mattering -- what actually killed 4 of the 9 runs was host
# RAM, not wall clock. Evidence, from the .out/.err logs of job 22507 (first
# submission, all 9 methods attempted) and job 22604 (resubmission, resuming
# the methods job 22507 left undone):
#   - job 22507's own .err: "Detected 6 oom_kill events in StepId=22507.batch"
#     plus 4 explicit "Killed" lines -- a SLURM/cgroup-level SIGKILL, not a
#     Python exception (nothing in any .out shows a traceback or "CUDA out of
#     memory" -- this is HOST RAM against --mem, not GPU VRAM).
#   - TUNA and EASE both silently stopped mid-run in that job (TUNA at task
#     15/20, EASE at task 10/20 -- no error text, just no further output).
#   - job 22604 (2026-08-30/31) correctly resumed only the methods job 22507
#     never reached "done" on (olora, rainbowprompt, tuna, ease -- confirmed
#     via scripts/_bankcap_run_done.py's own skip check, not guesswork).
#     O-LoRA ran ~10.5h this time and again stopped silently mid-run (task
#     11/20); RainbowPrompt was killed almost immediately (task 0, ~3 min
#     in, one more "Killed" PID in job 22604's .err) and took the whole job
#     down with it -- no further methods were attempted after it.
#   - Likely mechanism (inference, not directly confirmed -- no dmesg/cgroup
#     trace was available, only these logs): ce2_enabled wraps the ENTIRE
#     incremental_train() call in one torch.profiler(with_flops=True)
#     session per task (utils/ce2_profiler.py), retaining a full per-op event
#     trace in host memory for the whole task rather than CE1's old narrow
#     per-step sampling -- a much larger resident footprint, worse for
#     methods with heavier graphs (RainbowPrompt) or many training steps
#     accumulated per task.
# FIX: --mem bumped 64G -> 160G below. This is a guess at a safe margin, not
# a measured requirement -- if OOM kills recur even at 160G, that basically
# confirms the mechanism above and the next step would be checking actual
# peak RSS via `sacct -j <jobid> --format=MaxRSS` (not available from what
# was moved locally this time) rather than guessing further.
#
# RESUMABLE via scripts/_bankcap_run_done.py (fully generic despite the
# name -- reconstructs trainer.py's own metrics-path formula from a config's
# model_name/dataset/prefix/seed, checks status=="done"; reused verbatim).
#
# SINGLE GPU BY CONSTRUCTION: plain sequential loop, CUDA_VISIBLE_DEVICES
# pinned to 0, no worker-pool/FIFO fan-out.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=ce_eval_wave1_imagenetr20t
CONFIG_DIR="exps/$CAMPAIGN"
OUT_DIR="run_logs/$CAMPAIGN"
mkdir -p "$CONFIG_DIR" "$OUT_DIR"

LOCKFILE="$OUT_DIR/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check -- single-GPU by construction, sequential loop,
# same idiom as every other script in this project.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_ce_eval_wave1_imagenetr20t_configs.py
echo "==== config generation done $(date) ===="

run_one() {
  # $1 = path to config json.
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  # A retry's plain `>` used to silently overwrite a prior failed attempt's
  # log -- exactly what made it impossible to see WHERE job 22507's O-LoRA
  # and RainbowPrompt attempts actually died once job 22604 overwrote both
  # files with its own (also-failed) retry. Back up any existing outfile
  # first so a resubmission never destroys the previous attempt's evidence.
  if [ -f "$outfile" ]; then
    mv "$outfile" "${outfile}.prev-${SLURM_JOB_ID:-unknown}"
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

# Ordering note (2026-08-31, revised after examining job 22507/22604): the
# original "ascending wall-time risk" ordering below turned out not to
# matter -- what actually killed runs was host RAM (see HOST MEMORY note
# above), and of the 4 methods that failed, RainbowPrompt is the one that
# died fastest (task 0, ~3 min in) AND took the whole job down with it,
# blocking every method after it in the list from even being attempted.
# Moved it to run LAST among the not-yet-done methods so that if it fails
# again despite the --mem bump, O-LoRA/TUNA/EASE (which each made real
# partial progress last time -- 11/20, 15/20, 10/20 tasks respectively, so
# more headroom may be enough) have already banked their results in the same
# submission rather than being blocked behind another RainbowPrompt crash.
# seqlora/inflora/treelora/sketchlora/cllora are already done and will just
# SKIP instantly regardless of position.
METHOD_ORDER="seqlora inflora treelora sketchlora cllora olora tuna ease rainbowprompt"

echo "==== ${CAMPAIGN} start: 9 methods x 1 seed, single GPU $(date) ===="

for METHOD in $METHOD_ORDER; do
  run_one "$CONFIG_DIR/${METHOD}_s1993.json"
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
