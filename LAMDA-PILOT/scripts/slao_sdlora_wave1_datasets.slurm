#!/bin/bash
#SBATCH --job-name=slao_sdlora_wave1_datasets
#SBATCH --time=72:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/slao_sdlora_wave1_datasets/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/slao_sdlora_wave1_datasets/slurm_%j.err
#
# SLAO and SD-LoRA, full oracle (real task-boundary) regime, across all five
# master-table datasets (2026-11-02 user request) -- a SEPARATE experiment
# from sketchlora_streamsample_wave1.slurm: this measures vanilla SLAO/
# SD-LoRA's own standing accuracy on each dataset, to gauge them against
# SketchLoRA's own master-table numbers. NEITHER method is run under
# boundary_mode="sample" here -- no streaming involved at all, ordinary
# per-task incremental_train() loop, same as every other oracle campaign in
# this project.
#
# Settled learning rates (see scripts/gen_slao_sdlora_wave1_datasets_configs.py's
# own docstring for the full provenance):
#   - imagenetr: own tuned winner -- SLAO=8e-4, SD-LoRA=8e-3
#   - cifar224:  own tuned winner -- SLAO=1e-3, SD-LoRA=5e-3
#   - sun397, food101, omnibenchmark1k: never tuned on this machine (SUN397/
#     Food-101 never attempted; OmniBenchmark-1k crashed immediately, no
#     local data) -- use cifar224's own winning LR for both methods
#     (explicit 2026-10-30/2026-11-02 user decision), matching the pattern
#     this project's other methods show when their own CIFAR-100/ImageNet-R
#     LRs differ.
#
# 5 datasets x 2 methods x 3 seeds = 30 runs.
#
# Configs are STATIC (exps/slao_sdlora_wave1_datasets/{slao,sdlora}/,
# 30 files, generated by scripts/gen_slao_sdlora_wave1_datasets_configs.py --
# committed, not regenerated at runtime).
#
# WALL TIME: UNMEASURED on this machine for 3 of the 5 datasets (sun397/
# food101/omnibenchmark1k were never run here at all -- no local data).
# The LR-tuning runs on imagenetr/cifar224 (5/10-task truncated) took
# ~100-120 min each; a full 10-task cifar224 run or 20-task imagenetr run
# will take roughly 2x/4x that per seed. omnibenchmark1k is a 100-task
# dataset -- by far the largest unknown here. 72h requested as a
# conservative floor, NOT a verified estimate -- check actual per-run
# durations after the first few complete and extend if needed.
# Resumable: run_one() skips any config whose own final_metrics JSON
# (run_logs/final/<model_name>/metrics_<tag>.json) already shows
# status=="done" (scripts/_bankcap_run_done.py, the same check this
# project's other oracle campaigns use) -- if the job hits the wall,
# resubmit and finished runs skip in seconds.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=slao_sdlora_wave1_datasets
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 30 configs are committed to the repo (scripts/gen_slao_sdlora_wave1_datasets_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local method
  local tag
  method="$(basename "$(dirname "$config")")"
  tag="${method}_$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 30 runs (2 methods x 5 datasets x 3 seeds) $(date) ===="

# method-major (slao first, sdlora second -- arbitrary but fixed), dataset-
# major within method ordered cheapest/most-measured first (imagenetr,
# cifar224 -- both already fully tuned/measured on this machine -- before
# the three untested datasets, food101/sun397 next as moderate-scale, then
# omnibenchmark1k LAST as the largest and least certain), seed-minor. A
# wall-clock cutoff this way still leaves the cheaper, better-understood
# datasets complete for both methods rather than every dataset partially
# done.
for METHOD in slao sdlora; do
  echo "-------- method: ${METHOD} --------"
  for DATASET in imagenetr cifar224 food101 sun397 omnibenchmark1k; do
    echo "---- dataset: ${DATASET} ----"
    for cfg in "$CONFIG_ROOT"/"$METHOD"/${DATASET}_s*.json; do
      run_one "$cfg"
    done
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
