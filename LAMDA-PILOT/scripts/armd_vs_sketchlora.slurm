#!/bin/bash
#SBATCH --job-name=armd_vs_sketchlora
#SBATCH --time=20:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/armd_vs_sketchlora/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/armd_vs_sketchlora/slurm_%j.err
#
# A-only fixed-rank orthogonalized SketchLoRA (sketchlora_align, align_mode=
# orth, weight=0.5, svd_rank pinned at 10 -- no adaptive/retain admission)
# vs. Arm D O-LoRA (real O-LoRA, bank_cap_mb=3.0 -- admits exactly 2 slots on
# EVERY dataset here, since one LoRA slot's byte cost is a pure architecture
# constant [rank=10, dim=768, 24 wrapped q/v modules], never dataset-
# dependent; merge left at its normal default True, i.e. NOT the nomerge
# ablation override -- see models/olora.py's bank-cap pinning logic: once the
# 3rd-slot admission is refused after task 1, slot 1 stays pinned and trains
# forever, orthogonalized only against slot 0's frozen A, while slot 0 stays
# folded into every forward exactly like uncapped O-LoRA. This is the
# "single-reference O-LoRA, but keep the merge" arm from
# olora_mechanism_ablation_imagenetr20t.slurm's own campaign, re-run here on
# 3 more datasets to check whether fixed-rank-orthogonalized SketchLoRA still
# beats the closest-to-vanilla single-slot O-LoRA outside ImageNet-R-20t).
#
# 3 methods x 3 seeds (1993/1996/1999) x 3 datasets = 27 runs:
#   1. A-only fixed-rank orthogonalized SketchLoRA (sketchlora_align,
#      align_mode=orth, weight=0.5, svd_rank pinned at 10).
#   2. Arm D O-LoRA (real O-LoRA, bank_cap_mb=3.0 -- 2 admitted slots on
#      every dataset, merge left at its normal default).
#   3. Adaptive-rank orthogonalized SketchLoRA (sketchlora_align,
#      sketchlora_admission="retain", svd_energy_target=0.25 -- keep 75% of
#      each newly-introduced adapter's own energy per task, sketch's
#      existing rank never evicted -- align_mode=orth, weight=0.5,
#      rank_cap=128).
# Datasets:
#   - cifar224 (10/10, naturally 10 tasks -- matches wave1_final's own shape)
#   - imagenetr (10/10, stop_after_tasks=10 -- "imagenetr10t", same
#     truncation convention as exps/treelora_routing_fix_check/)
#   - food101 (6/5, naturally 20 tasks -- matches wave1_final's own shape;
#     no "-10t" requested for this one, native shape used unchanged)
# All three use tuned_epoch=20/batch_size=48/init_lr=0.001/weight_decay=
# 0.0005/lora_rank=10 -- confirmed identical across datasets in the existing
# wave1_final configs before reusing those values here, not assumed.
#
# Configs are STATIC (exps/armd_vs_sketchlora/, 27 files, generated by
# scripts/gen_armd_vs_sketchlora_configs.py -- committed, not regenerated at
# runtime, matching olora_mechanism_ablation_imagenetr20t.slurm's convention
# rather than wave1_final.slurm's regenerate-every-launch one).
#
# WALL TIME: olora_mechanism_ablation_imagenetr20t.slurm measured ~28-30
# min/run for 20-task/20-epoch O-LoRA/SketchLoRA-family runs on this
# cluster; the "retain" admission arm does extra per-boundary SVD work as
# the sketch's rank grows, so budget it at the higher end of that range. The
# 18 ten-task runs (cifar224, imagenetr10t) should run in roughly half the
# 20-task rate, ~15-16 min each; the 9 food101 runs (20 tasks) at the full
# ~28-30 min. Estimate: 18*16 + 9*30 ~= 9.1h. 20h requested (2026-08-23 user
# decision) for substantial headroom. Resumable: run_one() skips any config
# whose final_metrics JSON already reports status=="done" (scripts/
# _bankcap_run_done.py, the same check olora_mechanism_ablation_imagenetr20t.
# slurm uses) -- if the job hits the wall, resubmit and finished runs skip
# in seconds.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=armd_vs_sketchlora
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 18 configs are committed to the repo (scripts/gen_armd_vs_sketchlora_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 27 runs (3 methods x 3 seeds x 3 datasets) $(date) ===="

# dataset-major (cheapest datasets first), method-major within each dataset,
# seed-minor -- so a wall-clock cutoff degrades to "all three methods have
# complete/partial coverage on the cheap datasets first" rather than food101
# (the most expensive) blocking cifar224/imagenetr10t from ever starting.
for TAG in cifar224_10t imagenetr10t food101; do
  echo "-------- dataset: ${TAG} --------"
  for cfg in "$CONFIG_ROOT"/armd_vs_sketchlora_fixedrank_orth05_${TAG}_s*.json; do
    run_one "$cfg"
  done
  for cfg in "$CONFIG_ROOT"/armd_vs_sketchlora_armD_olora_cap3_${TAG}_s*.json; do
    run_one "$cfg"
  done
  for cfg in "$CONFIG_ROOT"/armd_vs_sketchlora_adaptive_orth05_eps025_${TAG}_s*.json; do
    run_one "$cfg"
  done
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
