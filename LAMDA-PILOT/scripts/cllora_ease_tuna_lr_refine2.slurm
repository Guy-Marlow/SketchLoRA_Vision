#!/bin/bash
#SBATCH --job-name=cllora_ease_tuna_lr_refine2
#SBATCH --time=60:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_lr_refine2/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/cllora_ease_tuna_lr_refine2/slurm_%j.err
#
# Third-round LR sensitivity sweep for CL-LoRA/EASE/TUNA (2026-08-13 user
# request) -- follow-up to scripts/cllora_ease_tuna_rainbow_lr_refine.slurm.
# Configs: exps/cllora_ease_tuna_lr_refine2/<method>_<dataset>_<lrtag>.json,
# 35 total, generated by scripts/gen_cllora_ease_tuna_lr_refine2_configs.py
# (idempotent -- called fresh below). RainbowPrompt is NOT part of this
# round. Architecture/training-loop settings (20 epochs, batch 48, each
# method's own native optimizer) are unchanged -- only lr, dataset subset,
# and task-count truncation differ.
#
# Grid (single seed 1993, one run per cell):
#   CL-LoRA: {0.01, 0.03, 0.05} on omnibenchmark1k, {0.05} on cifar224,
#            {0.05} on sun397                                    = 5
#            (ImageNet-R and Food-101 are DONE -- lr=0.05 locked in as
#            final for both, intentionally absent from this grid)
#   EASE:    {0.001, 0.005, 0.01} on all 5 datasets               = 15
#            (the previous round's OmniBenchmark-1K "winner", 1e-5, was 3
#            orders of magnitude below Food-101's 1e-2 and only had 2 points
#            tested -- re-probing EASE's normal range on all 5 datasets for
#            a genuinely comparable read)
#   TUNA:    {0.001, 0.005, 0.01} on all 5 datasets               = 15
#            (previously only ever tested on ImageNet-R/OmniBenchmark-1K --
#            filling the CIFAR-100/Food-101/SUN397 gap)
#   TOTAL = 35 runs
#
# TASK-COUNT TRUNCATION (2026-08-13, the new standard going forward --
# longer than either prior round's, user-specified to make these numbers
# "solid" before locking in LRs for the long runs): CIFAR-100=5, SUN397=5,
# Food-101=10, ImageNet-R=10, OmniBenchmark-1K=20 (of the wave1_final
# splits' 10/10/20/20/100 tasks respectively).
#
# NO STRUCTURED LOGGING, same convention as both prior rounds: a short LR
# probe only needs the final top-1/top5 CIL number, which trainer.py prints
# unconditionally regardless of final_metrics/print_forget -- recoverable
# straight from each run's own .out log:
#   grep "CNN top5 curve:" run_logs/cllora_ease_tuna_lr_refine2/<tag>.out
# (last value in that list = final checkpoint's top-5; likewise "CNN top1 curve:").
#
# SINGLE GPU BY CONSTRUCTION, same idiom as every other script in this
# project: a plain sequential loop, CUDA_VISIBLE_DEVICES pinned to 0, no
# worker-pool/FIFO fan-out.
#
# RUN ORDER: method-major (CL-LoRA -> EASE -> TUNA, CL-LoRA first since it's
# the smallest slice and closest to being locked in), then alphabetically by
# whatever config filenames exist for that method (dataset, then lr tag) --
# a glob per method rather than nested dataset/lr loops, since CL-LoRA's
# dataset subset is irregular (3 datasets, uneven LR counts) while EASE/TUNA
# are a uniform 5x3 grid.
#
# RESUMABLE, same design as both prior rounds: no metrics-json status check
# (final_metrics=false means one is never written) -- completion is read
# directly off each run's own .out log instead. A cell whose .out file
# already has "Average Accuracy (CNN):" is skipped; the lockfile still
# guards against a second concurrent instance of this script.
#
# WALL TIME (60h, conservative): OmniBenchmark-1K now runs 20 tasks (vs the
# previous round's 15), so cells run somewhat longer on average -- not
# directly measured yet for this specific grid. The resumable design means a
# resubmission just continues from whatever the .out logs show incomplete,
# in the same fixed order, if 60h isn't enough.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/cllora_ease_tuna_lr_refine2

LOCKFILE="run_logs/cllora_ease_tuna_lr_refine2/.cllora_ease_tuna_lr_refine2.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another cllora_ease_tuna_lr_refine2.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check ONLY -- single-GPU by construction (see header), so
# there is no worker-pool size to derive from this.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless, this script never uses a second device."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_cllora_ease_tuna_lr_refine2_configs.py
echo "==== config generation done $(date) ===="

CONFIG_DIR="exps/cllora_ease_tuna_lr_refine2"
OUT_DIR="run_logs/cllora_ease_tuna_lr_refine2"
METHODS=(cllora ease tuna)

N_TOTAL=$(ls "$CONFIG_DIR"/*.json 2>/dev/null | wc -l)
echo "==== cllora_ease_tuna_lr_refine2 start: ${N_TOTAL} configs across ${#METHODS[@]} methods, single GPU, single seed (1993), no structured logging $(date) ===="

run_one() {
  # $1=path to config json
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  # No metrics json exists for these runs (final_metrics=false) -- completion
  # is read directly from the .out log's own unconditional final-summary print
  # instead (trainer.py: printed once, after the last checkpoint's CNN top1/
  # top5 curve, only on a run that actually finished).
  if [ -f "$outfile" ] && grep -q "Average Accuracy (CNN):" "$outfile"; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

for METHOD in "${METHODS[@]}"; do
  for CONFIG in $(ls "$CONFIG_DIR/${METHOD}"_*.json 2>/dev/null | sort); do
    run_one "$CONFIG"
  done
done

echo "==== ALL CLLORA_EASE_TUNA_LR_REFINE2 RUNS COMPLETE (or wall reached) $(date) ===="
