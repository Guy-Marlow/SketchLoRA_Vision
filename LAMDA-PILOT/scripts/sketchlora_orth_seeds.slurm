#!/bin/bash
#SBATCH --job-name=sketchlora_orth_seeds
#SBATCH --time=40:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_orth_seeds/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_orth_seeds/slurm_%j.err
#
# SketchLoRA-orth (models/sketchlora_align.py, sketchlora_align_mode="orth",
# weight 0.5) on ImageNet-R-20t, 3 seeds x 2 rank-selection arms (fixed,
# adaptive) = 6 runs. Follows up the single-seed (1993) local run that
# tracked this variant closely against O-LoRA's full-accumulation config
# throughout a 20-task horizon -- this campaign replicates that adaptive
# arm across 2 more seeds, and adds a fixed-rank arm for direct comparison
# against SketchLoRA's own fixed-rank ablation results.
#
# Configs: exps/sketchlora_orth_seeds/{fixed,adaptive}_s<seed>.json,
# generated by scripts/gen_sketchlora_orth_seeds_configs.py (idempotent,
# called fresh below). Both arms share every hyperparameter with
# exps/wave1_final/sketchlora_imagenetr_s1993.json except the orth
# regularizer and (for the fixed arm) rank selection -- see that script's
# own docstring for the exact diff.
#
# RESUMABLE via scripts/_bankcap_run_done.py (fully generic despite the
# name -- reconstructs trainer.py's own metrics-path formula from a
# config's model_name/dataset/prefix/seed, checks status=="done").
#
# SINGLE GPU BY CONSTRUCTION: plain sequential loop, CUDA_VISIBLE_DEVICES
# pinned to 0, no worker-pool/FIFO fan-out.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=sketchlora_orth_seeds
CONFIG_DIR="exps/$CAMPAIGN"
OUT_DIR="run_logs/$CAMPAIGN"
mkdir -p "$CONFIG_DIR" "$OUT_DIR"

LOCKFILE="$OUT_DIR/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check -- single-GPU by construction, sequential loop,
# same idiom as every other script in this project.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_sketchlora_orth_seeds_configs.py
echo "==== config generation done $(date) ===="

run_one() {
  # $1 = path to config json.
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_DIR}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

# Adaptive arm first (matches the already-validated single-seed run's
# settings, so it's the lower-risk/higher-confidence arm), fixed arm second.
SEEDS="1993 1996 1999"

echo "==== ${CAMPAIGN} start: 2 arms x 3 seeds, single GPU $(date) ===="

for SEED in $SEEDS; do
  run_one "$CONFIG_DIR/adaptive_s${SEED}.json"
done
for SEED in $SEEDS; do
  run_one "$CONFIG_DIR/fixed_s${SEED}.json"
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
