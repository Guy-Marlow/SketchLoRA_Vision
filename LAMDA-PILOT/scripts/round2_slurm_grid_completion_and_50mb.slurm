#!/bin/bash
#SBATCH --job-name=round2_slurm_grid_completion_and_50mb
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=18
#SBATCH --mem=128G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/round2_slurm_grid/slurm_completion50mb_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/round2_slurm_grid/slurm_completion50mb_%j.err
#
# Two-part follow-up to scripts/round2_slurm_grid.slurm (2026-07-31 user
# request, superseding the earlier 300MB plan). Same output directory, same
# naming scheme, same run_one() convention as the original script -- new
# .out/.json files land in exactly the same places the existing round2_
# slurm_grid data lives, so everything stays directly comparable.
#
# PART 1 -- complete the known gaps in the existing 100/200MB grid:
#   - seqlora_100mb_s1993 AND sketchlora_100mb_s1993: both are the surviving,
#     never-completed output of job 21982, killed 86min in (a job-queue race
#     in the successful resubmission, job 21983, skipped re-launching either
#     of them -- see prior analysis). seqlora reached 4/10 checkpoints (40%
#     of stream), sketchlora reached 3/10 (30%). Every other SketchLoRA cell
#     in this grid (100MB s1996/s1999, all of 200MB) already completed under
#     the exact frozen-v1 config (bounded_eviction/rank_cap=128/lora_wd=0/no
#     shrink) intended for this whole series, so only this one missing cell
#     needs to run -- not a re-run of already-complete SketchLoRA cells. Both
#     jobs use the exact same exps/round2_slurm_grid/{seqlora,sketchlora}_
#     100mb_s1993.json this series has used throughout -- not regenerated,
#     not re-tuned.
#   - treelora_{100,200}mb x {1993,1996,1999}: all 6 cells crashed on cycle 0
#     under the code that was live when the original grid ran (d964a0e) --
#     AttributeError: 'NoneType' object has no attribute 'shape'
#     (utils/kd_tree.py:104, self.tree.current_grad never populated because
#     models/treelora.py had no _bounded_train_epoch override at that
#     commit). That override now exists in the current tree -- this is its
#     first real exercise on H200. Confirmed present and wired: models/
#     treelora.py::persistent_state() (line 110) and models/bounded_memory_
#     mixin.py's unconditional MetricsLogger construction (line ~366) --
#     TreeLoRA gets the same top1/top5/persistent-memory/FLOP/latency
#     metrics as every other method in this grid, no special-casing needed.
#
# PART 2 -- every method, fresh, on the new 50MB budget point, all 3 seeds
# (15 runs). Configs generated by the SAME scripts/gen_round2_slurm_grid_
# configs.py used for 100/200MB (now extended to BUDGETS=[50,100,200],
# verified via md5sum that re-running it left every existing 100MB/200MB
# config file byte-identical -- this script is idempotent by construction,
# not just by assumption).
#
# SAFETY / "don't touch good data": this script's job list is a HARDCODED,
# explicit 22-item set (7 completions + 15 new 50MB runs) -- it structurally
# cannot select seqlora_{100,200}mb's other seeds, sketchlora/olora/inflora
# at 100MB/200MB, or anything else already complete, regardless of what any
# skip-check does or doesn't find. The skip-check below (same convention as
# round2_slurm_grid.slurm: accuracy json partial:false AND metrics json
# status:done) is retained ONLY as a resubmission safety net within this
# fixed 22-item list (e.g. if this script itself gets wall-killed partway and
# resubmitted) -- it is not what keeps this script from touching the
# existing 100/200MB seqlora/sketchlora/olora/inflora results; the hardcoded
# job list is what does that.
#
# KNOWN OPEN QUESTION, flagged rather than assumed: the skip-check reads
# run_logs/final/<method>/metrics_*.json, which was deleted from the LOCAL
# (analysis-machine) copy of this data earlier in this session. This script
# reads the H200's OWN filesystem when it runs there, which should be
# unaffected by that local deletion -- but I have not independently confirmed
# the H200-side files are intact. Given the hardcoded job list above, the
# only consequence if they were somehow also missing on H200 is that a
# resubmission of THIS script could redo one of these 22 cells a second time
# (harmless -- all 22 are cells we want run/re-run anyway) -- it cannot cause
# this script to touch seqlora_{100,200}mb's good seeds or sketchlora/olora/
# inflora at 100MB/200MB, which are simply never in its job list.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/round2_slurm_grid

# Refuse to run alongside anything else that claims these 2 GPUs.
for OTHER_LOCK in \
  "run_logs/round2_slurm_grid/.round2_slurm_grid.lock" \
  "run_logs/round2_slurm_grid/.round2_slurm_grid_treelora_only.lock"; do
  if [ -f "$OTHER_LOCK" ] && kill -0 "$(cat "$OTHER_LOCK")" 2>/dev/null; then
    echo "FATAL: $OTHER_LOCK (PID $(cat "$OTHER_LOCK")) appears to be running -- refusing to start a second job on the same 2 GPUs. Wait for it to finish or delete the lockfile if stale."
    exit 1
  fi
done
LOCKFILE="run_logs/round2_slurm_grid/.round2_slurm_grid_completion_and_50mb.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another instance of this script (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID

# Pre-flight sanity check (same convention as round2_slurm_grid.slurm).
if ! python -c "import torch, timm; assert torch.cuda.is_available()" 2>/tmp/round2_slurm_grid_completion50mb_preflight_$$.err; then
  echo "FATAL: pre-flight check failed (torch/timm import or CUDA unavailable). Details:"
  cat /tmp/round2_slurm_grid_completion50mb_preflight_$$.err
  rm -f /tmp/round2_slurm_grid_completion50mb_preflight_$$.err
  exit 1
fi
rm -f /tmp/round2_slurm_grid_completion50mb_preflight_$$.err

echo "==== config generation start $(date) ===="
python scripts/gen_round2_slurm_grid_configs.py
echo "==== config generation done $(date) ===="

NGPU=2

run_one() {
  # $1=gpu $2=method $3=budget $4=seed -- identical naming/skip-check
  # convention to round2_slurm_grid.slurm's run_one().
  local gpu="$1" method="$2" budget="$3" seed="$4"
  local tag="${method}_${budget}mb_s${seed}"
  local config="exps/round2_slurm_grid/${tag}.json"
  local prefix="round2_slurm_grid_omni30t_${budget}mb_${method}_s${seed}"
  local json="run_logs/boundedmem_${method}_${prefix}_s${seed}.json"
  local metrics_json="run_logs/final/${method}/metrics_${method}_${prefix}_s${seed}.json"

  if [ ! -f "$config" ]; then
    echo "==== FATAL (missing config) ${tag} $(date) ===="
    return
  fi
  if [ -f "$json" ] && grep -q '"partial": false' "$json" \
     && [ -f "$metrics_json" ] && grep -q '"status": "done"' "$metrics_json"; then
    echo "==== SKIP (already done, accuracy+metrics both complete) ${tag} $(date) ===="
    return
  fi
  echo "==== START [gpu ${gpu}] ${tag} $(date) ===="
  CUDA_VISIBLE_DEVICES="${gpu}" python main.py --config "$config" \
    > "run_logs/round2_slurm_grid/${tag}.out" 2>&1 || true
  echo "==== DONE  [gpu ${gpu}] ${tag} $(date) ===="
}

run_queue() {
  # $1 = queue name (for logging), $2.. = "method|budget|seed" job strings.
  # Writer is a subshell that echoes each job into the FIFO, exactly the same
  # mechanism round2_slurm_grid.slurm itself uses (a background subshell
  # writing lines into a mkfifo, consumed by N worker loops each doing
  # `while read ... ; done < "$FIFO"`) -- deliberately NOT a heredoc piped
  # through `cat`, to avoid relying on background-job stdin-inheritance
  # semantics that, while correct in a non-interactive script, are an
  # unnecessary source of doubt when this can't be dry-run on the target
  # cluster first. Passing jobs as "$@" (a real array) rather than stdin text
  # removes that dependency entirely.
  local qname="$1"; shift
  local FIFO="run_logs/round2_slurm_grid/.jobs_${qname}.fifo"
  rm -f "$FIFO"
  mkfifo "$FIFO"

  ( for job in "$@"; do echo "$job"; done ) > "$FIFO" &
  local WRITER_PID=$!

  worker() {
    local gpu="$1" method budget seed
    while IFS='|' read -r method budget seed; do
      run_one "$gpu" "$method" "$budget" "$seed"
    done < "$FIFO"
  }
  for (( g=0; g<NGPU; g++ )); do
    worker "$g" &
  done
  wait
  wait "$WRITER_PID" 2>/dev/null || true
  rm -f "$FIFO"
}

PART1_JOBS=(
  "seqlora|100|1993"
  "sketchlora|100|1993"
  "treelora|100|1993"
  "treelora|100|1996"
  "treelora|100|1999"
  "treelora|200|1993"
  "treelora|200|1996"
  "treelora|200|1999"
)
echo "==== PART 1: complete outstanding 100/200MB gaps (${#PART1_JOBS[@]} jobs) start $(date) ===="
run_queue "part1_completion" "${PART1_JOBS[@]}"
echo "==== PART 1 done $(date) ===="

# seed-major, method-minor within the budget -- matches round2_slurm_grid.slurm's
# own within-budget ordering convention exactly.
PART2_JOBS=(
  "seqlora|50|1993" "sketchlora|50|1993" "olora|50|1993" "inflora|50|1993" "treelora|50|1993"
  "seqlora|50|1996" "sketchlora|50|1996" "olora|50|1996" "inflora|50|1996" "treelora|50|1996"
  "seqlora|50|1999" "sketchlora|50|1999" "olora|50|1999" "inflora|50|1999" "treelora|50|1999"
)
echo "==== PART 2: all 5 methods x 50MB x 3 seeds (${#PART2_JOBS[@]} jobs) start $(date) ===="
run_queue "part2_50mb" "${PART2_JOBS[@]}"
echo "==== PART 2 done $(date) ===="

echo "==== ALL COMPLETION + 50MB RUNS DONE (or wall reached) $(date) ===="
