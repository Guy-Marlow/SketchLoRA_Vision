#!/bin/bash
#SBATCH --job-name=sketchlora_orth_omnibenchmark1k
#SBATCH --time=72:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_orth_omnibenchmark1k/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_orth_omnibenchmark1k/slurm_%j.err
#
# Fixed-rank and adaptive orthogonalized SketchLoRA (sketchlora_align,
# align_mode=orth) on OmniBenchmark-1k, 3 seeds (1993/1996/1999) x 2 methods
# = 6 runs -- the same two arms from armd_vs_sketchlora.slurm (cifar224/
# imagenetr10t/food101), extended to the 100-task Omni-1k split:
#   1. Fixed-rank: svd_rank pinned at 10, weight=0.5.
#   2. Adaptive:   sketchlora_admission="retain", svd_energy_target=0.25,
#                  rank_cap=128, weight=0.5.
# Both uncapped (bank_cap_mb unset) -- capping was only ever the separate
# Arm-D O-LoRA arm's thing, not requested here. init_cls=10/increment=10 on
# omnibenchmark1k's 1000-class set -> 100 tasks, no stop_after_tasks
# truncation, matching wave1_final's own omnibenchmark1k shape and
# SketchLoRA's established lr=0.001 there.
#
# Configs are STATIC (exps/sketchlora_orth_omnibenchmark1k/, 6 files,
# generated by scripts/gen_sketchlora_orth_omnibenchmark1k_configs.py --
# committed, not regenerated at runtime, matching armd_vs_sketchlora.slurm's
# convention).
#
# LOGGING LAYOUT:
#   - stdout/stderr for each run:      run_logs/sketchlora_orth_omnibenchmark1k/<tag>.out
#   - SLURM's own driver log:          run_logs/sketchlora_orth_omnibenchmark1k/slurm_<jobid>.{out,err}
#   - per-layer sketch diagnostics (JSON), one subfolder per method:
#       run_logs/sketchlora_orth_omnibenchmark1k/sketch_diag_fixedrank/
#       run_logs/sketchlora_orth_omnibenchmark1k/sketch_diag_adaptive/
#   - the harness's own summary metrics JSON (accuracy/forgetting/persistent_mb,
#     via utils/metrics_logger.py) does NOT follow this campaign folder -- it is
#     hardcoded project-wide (trainer.py) to always land in
#     run_logs/final/sketchlora_align/metrics_<tag>.json, regardless of which
#     campaign/config produced it. No config field can redirect it; every other
#     campaign in this repo has the same constraint.
#
# WALL TIME: no direct precedent for a 100-task orth-SketchLoRA run's per-task
# cost at this scale -- the "retain" adaptive arm's per-boundary SVD cost
# grows with the sketch's rank over the run (see armd_vs_sketchlora.slurm's
# own note), and 100 tasks is 5-10x longer than anything this pair has been
# run on before. 72h requested (2026-08-26 user decision) across 6 runs is
# ~12h/run average budget. Resumable: run_one() skips any config whose
# final_metrics JSON already reports status=="done" (scripts/
# _bankcap_run_done.py) -- if the job hits the wall, resubmit and finished
# runs skip in seconds.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }

CAMPAIGN=sketchlora_orth_omnibenchmark1k
CONFIG_ROOT="exps/$CAMPAIGN"
OUT_ROOT="run_logs/$CAMPAIGN"
mkdir -p "$OUT_ROOT" "$OUT_ROOT/sketch_diag_fixedrank" "$OUT_ROOT/sketch_diag_adaptive"

if [ ! -d "$CONFIG_ROOT" ]; then
  echo "FATAL: $CONFIG_ROOT not found -- the 6 configs are committed to the repo (scripts/gen_sketchlora_orth_omnibenchmark1k_configs.py), not generated here. Pull the branch that adds them."
  exit 1
fi

LOCKFILE="$OUT_ROOT/.$CAMPAIGN.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another $CAMPAIGN.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

run_one() {
  local config="$1"
  local tag
  tag="$(basename "$config" .json)"
  local outfile="${OUT_ROOT}/${tag}.out"

  if python scripts/_bankcap_run_done.py "$config" 2>/dev/null; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "$outfile" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

echo "==== ${CAMPAIGN} start: 6 runs (2 methods x 3 seeds), OmniBenchmark-1k $(date) ===="

# method-major, seed-minor -- so a wall-clock cutoff degrades to "one method
# has full 3-seed coverage" rather than both methods ending up partial.
for cfg in "$CONFIG_ROOT"/sketchlora_orth_omnibenchmark1k_fixedrank_orth05_s*.json; do
  run_one "$cfg"
done
for cfg in "$CONFIG_ROOT"/sketchlora_orth_omnibenchmark1k_adaptive_orth025_s*.json; do
  run_one "$cfg"
done

echo "==== ALL ${CAMPAIGN} RUNS COMPLETE (or wall reached) $(date) ===="
