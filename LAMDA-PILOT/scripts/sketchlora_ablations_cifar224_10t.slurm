#!/bin/bash
#SBATCH --job-name=sketchlora_ablations_cifar224_10t
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --open-mode=append
#SBATCH --output=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_ablations_cifar224_10t/slurm_%j.out
#SBATCH --error=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT/run_logs/sketchlora_ablations_cifar224_10t/slurm_%j.err
#
# SketchLoRA ablation series, ported to CIFAR-100-10t (user request
# 2026-08-13) -- a UNIFIED rerun of the same 6 ablations previously run on
# ImageNet-R-20t across TWO separate SLURM scripts/campaigns
# (scripts/sketchlora_ablations_imagenetr20t.slurm +
# scripts/sketchlora_ablations_imagenetr20t_repair_a.slurm for the SVD-
# variant/countsketch/noadapt cells, exps/sketchlora_ablations_and_sens/
# reduce_merge_sens/ for reduce_merge). This script runs all 6 in one shot.
#
# Configs: exps/sketchlora_ablations_cifar224_10t/<variant>_s<seed>.json, 18
# total (6 variants x 3 seeds), generated by
# scripts/gen_sketchlora_ablations_cifar224_10t_configs.py (idempotent --
# called fresh below). That generator loads each variant's ACTUAL ImageNet-R
# config as its source of truth and patches ONLY dataset/prefix (+
# reduce_merge's sketchlora_diag_dir) -- every other field (merge_op,
# admission policy, rank_cap, svd_energy_target, optimizer/schedule, epochs,
# batch size) is copied byte-for-byte from what actually ran on ImageNet-R,
# confirmed via diff before this script was written. init_cls/increment stay
# 10/10 (CIFAR-100's 100 classes / 10 = 10 tasks, vs ImageNet-R's 200/10=20).
#
# SIX variants (excludes "Random SVD + Floor"/sketchlora_current and
# "Sequential LoRA"/seqlora -- both already have completed CIFAR-100 data
# from other campaigns, per explicit user instruction):
#   exactsvd     -- "Exact SVD + Floor"     (merge_op=exactsvd, bounded_eviction)
#   globaleps    -- "Random SVD"            (merge_op=randsvd, global_eps, no floor)
#   reduce_merge -- "Reversed Sketch/Merge" (merge_op=reduce_merge)
#   fixedrank    -- "Fixed + Random SVD"    (merge_op=randsvd, no svd_energy_target)
#   countsketch  -- "Fixed + CountSketch"   (merge_op=countsketch, no svd_energy_target)
#   noadapt      -- "No Adaptation"         (frozen backbone, no LoRA)
#
# RESOURCES (1 GPU, 8 CPU cores, 48GB RAM -- explicit user request
# 2026-08-13): single GPU by construction, plain sequential loop -- no
# worker-pool/FIFO fan-out (unlike the original ImageNet-R script's
# NGPU-derived worker pool, built when more GPUs might have been available;
# not needed here since the user explicitly wants 1 GPU).
#
# RESUMABLE / LOCKFILE: same convention as every other script in this
# project -- skips a cell whose metrics json already shows "status": "done";
# refuses to start a second instance of itself.
#
# WALL TIME (48h): not directly measured for this specific grid yet.
# CIFAR-100-10t has half ImageNet-R-20t's task count, so cells should run
# faster on average than the ~144h full-sequential estimate noted in the
# original ImageNet-R script's own comments -- but this is not a precise
# extrapolation. The resumable design means a resubmission just continues
# from whatever's still incomplete, in the same fixed order, if 48h isn't
# enough for one submission.
#
# >>> CLUSTER-SPECIFIC: conda env name -- adjust CONDA_ENV_NAME if not "treelora" <<<

set -uo pipefail

VISION=/data/gmar762/research/continuous_learning/svd_sketching_vision/LAMDA-PILOT
cd "$VISION" || { echo "FATAL: cannot cd to $VISION -- check the path for this cluster"; exit 1; }
mkdir -p run_logs/sketchlora_ablations_cifar224_10t

LOCKFILE="run_logs/sketchlora_ablations_cifar224_10t/.sketchlora_ablations_cifar224_10t.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
  echo "FATAL: another sketchlora_ablations_cifar224_10t.slurm instance (PID $(cat "$LOCKFILE")) appears to be running -- refusing to start a second one. Delete $LOCKFILE if this is stale."
  exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

source /data/gmar762/anaconda3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_NAME:-treelora}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0

# Pre-flight sanity check ONLY -- single-GPU by construction (see header), so
# there is no worker-pool size to derive from this.
PREFLIGHT_ERR="$(mktemp)"
NGPU=$(python -c "import torch, timm; assert torch.cuda.is_available(); print(torch.cuda.device_count())" \
  2>"$PREFLIGHT_ERR")
if [ -z "$NGPU" ] || ! [[ "$NGPU" =~ ^[1-9][0-9]*$ ]]; then
  echo "FATAL: pre-flight check failed (torch/timm import, CUDA unavailable, or non-numeric device count). Details:"
  cat "$PREFLIGHT_ERR"
  rm -f "$PREFLIGHT_ERR"
  exit 1
fi
rm -f "$PREFLIGHT_ERR"
if [ "$NGPU" != "1" ]; then
  echo "NOTE: torch.cuda.device_count()=${NGPU} (expected 1 for this job's --gres=gpu:1) -- proceeding on CUDA_VISIBLE_DEVICES=0 regardless, this script never uses a second device."
fi
echo "==== pre-flight OK, CUDA_VISIBLE_DEVICES=0 $(date) ===="

echo "==== config generation start $(date) ===="
python scripts/gen_sketchlora_ablations_cifar224_10t_configs.py
echo "==== config generation done $(date) ===="

CONFIG_DIR="exps/sketchlora_ablations_cifar224_10t"
OUT_DIR="run_logs/sketchlora_ablations_cifar224_10t"
SEEDS=(1993 1996 1999)

# file_basename|short_tag|model_name -- file_basename matches the config's
# actual filename (<file_basename>_s<seed>.json); short_tag matches the
# generator's own prefix convention (sketchlora_ablations_cifar224_10t_
# <short_tag>_s<seed>); model_name is what trainer.py's final_metrics path
# uses for the metrics-json directory/tag (same formula as every other
# oracle-path script in this project: "{model_name}_{dataset}_{prefix}_s{seed}").
VARIANTS=(
  "sketchlora_exactsvd|exactsvd|sketchlora"
  "sketchlora_globaleps|globaleps|sketchlora"
  "sketchlora_fixedrank|fixedrank|sketchlora"
  "sketchlora_countsketch|countsketch|sketchlora"
  "noadapt|noadapt|noadapt"
  "reduce_merge|reduce_merge|sketchlora"
)

echo "==== sketchlora_ablations_cifar224_10t start: ${#VARIANTS[@]} variants x ${#SEEDS[@]} seeds = $(( ${#VARIANTS[@]} * ${#SEEDS[@]} )) runs, single GPU $(date) ===="

run_one() {
  # $1=file_basename $2=short_tag $3=model_name $4=seed
  local file_basename="$1" short_tag="$2" model_name="$3" seed="$4"
  local tag="${file_basename}_s${seed}"
  local config="${CONFIG_DIR}/${tag}.json"
  local prefix="sketchlora_ablations_cifar224_10t_${short_tag}_s${seed}"
  # oracle path (trainer.py, final_metrics gate): metrics tag is
  # "{model_name}_{dataset}_{prefix}_s{seed}", same formula as
  # sketchlora_ablations_imagenetr20t.slurm's own run_one().
  local metrics_tag="${model_name}_cifar224_${prefix}_s${seed}"
  local metrics_json="run_logs/final/${model_name}/metrics_${metrics_tag}.json"

  if [ ! -f "$config" ]; then
    echo "==== SKIP (no config) ${tag} $(date) ===="
    return
  fi
  if [ -f "$metrics_json" ] && grep -q '"status": "done"' "$metrics_json"; then
    echo "==== SKIP (done) ${tag} $(date) ===="
    return
  fi
  echo "==== START ${tag} $(date) ===="
  python main.py --config "$config" \
    > "${OUT_DIR}/${tag}.out" 2>&1 || true
  echo "==== DONE  ${tag} $(date) ===="
}

for ENTRY in "${VARIANTS[@]}"; do
  IFS='|' read -r FILE_BASENAME SHORT_TAG MODEL_NAME <<< "$ENTRY"
  for SEED in "${SEEDS[@]}"; do
    run_one "$FILE_BASENAME" "$SHORT_TAG" "$MODEL_NAME" "$SEED"
  done
done

echo "==== ALL SKETCHLORA_ABLATIONS_CIFAR224_10T RUNS COMPLETE (or wall reached) $(date) ===="
